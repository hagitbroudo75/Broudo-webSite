{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "WriteTo": [
      { "Name": "Async", "Args": { "configure": [ { "Name": "Console" } ] } }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=/var/data/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": true,
        "UmbracoMediaPhysicalRootPath": "/var/data/media"
      },
      "Unattended": {
        "InstallUnattended": true
      }
    }
  },
  "uSync": {
    "Settings": {
      "ImportAtStartup": "Settings",
      "BackgroundStartup": false
    }
  },
  "Broudo": {
    "SeedDefaultContent": true,
    "DataProtectionKeysPath": "/var/data/keys"
  }
}
