@* Header, footer and floating WhatsApp button from the prototype. Contact details, company details and the
   legal texts come from Site Settings; navigation comes from Site Settings when set there, otherwise from the
   pages under the home page (text pages such as the privacy policy go to the legal row of the footer). *@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>
@{
    Layout = null;
    var settings = Umbraco.Settings();
    var home = Umbraco.Home();
    var isHome = Model.ContentType.Alias == "HomePage";
    var seoTitle = Model.Value<string>("seoTitle");
    var title = !string.IsNullOrWhiteSpace(seoTitle) ? seoTitle
        : isHome ? "Broudo Holdings — " + (settings?.Value<string>("footerTagline")?.TrimEnd('.') ?? "Real estate development")
        : Model.Name + " — Broudo Holdings";
    var description = Model.Value<string>("seoDescription") ?? (Model.ContentType.Alias == "ProjectPage" ? Model.Value<string>("summary") : null);
    var shareImage = Model.Value<IPublishedContent>("openGraphImage")?.Url(mode: UrlMode.Absolute);

    var pages = home?.Children().Where(page => page.ContentType.Alias != "TextPage" && !page.Value<bool>("hideFromNavigation")).ToList() ?? [];
    var navigation = settings.Links("primaryNavigation");
    if (navigation.Count == 0)
    {
        navigation = pages.Select(page => (page.NavigationLabel(), page.Url())).ToList();
    }
    var footerNavigation = settings.Links("footerNavigation");
    if (footerNavigation.Count == 0)
    {
        footerNavigation = pages.Where(page => page.ContentType.Alias != "ContactPage").Select(page => (page.NavigationLabel(), page.Url())).ToList();
    }
    var legalPages = home?.Children().Where(page => page.ContentType.Alias == "TextPage").ToList() ?? [];
    var contactUrl = Umbraco.Section("ContactPage")?.Url() ?? "#";
    var currentPath = Model.Url();
    bool IsCurrent(string url) => url != home?.Url() && currentPath.StartsWith(url, StringComparison.OrdinalIgnoreCase);

    var email = settings?.Value<string>("contactEmail") ?? "";
    var phone = settings?.Value<string>("phone") ?? "";
    var whatsApp = settings.WhatsAppUrl();
    var company = settings?.Value<string>("companyName") ?? "Broudo Holdings";
    var registeredIn = settings?.Value<string>("registeredIn");
    var linkedIn = settings?.Value<IEnumerable<Link>>("linkedInUrl")?.FirstOrDefault();
    var instagram = settings?.Value<IEnumerable<Link>>("instagramUrl")?.FirstOrDefault();

    // Language switcher: the same page in each language it is published in (hidden while the site has one language)
    var languages = Model.Cultures.Keys.Where(culture => culture != "" && Model.IsPublished(culture))
        .Select(culture => (Code: culture.Split('-')[0], Url: Model.Url(culture)))
        .ToList();
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!doctype html>
<html lang="@lang" dir="@(lang == "he" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title</title>
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <meta name="description" content="@description">
    }
    @if (Model.Value<bool>("noIndex"))
    {
        <meta name="robots" content="noindex">
    }
    <meta property="og:title" content="@title">
    @if (shareImage is not null)
    {
        <meta property="og:image" content="@shareImage">
    }
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#0E1B2C">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&amp;family=Manrope:wght@400;500;600&amp;display=swap">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
    <a href="@(home?.Url() ?? "/")" class="logo" aria-label="Broudo Holdings — home">
        @await Html.PartialAsync("Partials/Broudo/Logo")
    </a>
    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false">
        <svg width="22" height="16" viewBox="0 0 22 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M0 1h22M0 8h22M0 15h22"/></svg>
    </button>
    <nav class="site-nav" aria-label="Main">
        @foreach (var (label, url) in navigation)
        {
            <a href="@url" aria-current="@(IsCurrent(url) ? "page" : null)">@label</a>
        }
    </nav>
    <div class="header-actions">
        @if (languages.Count > 1)
        {
            <span class="lang">
                @for (var i = 0; i < languages.Count; i++)
                {
                    @if (i > 0) { <text> / </text> }
                    <a href="@languages[i].Url" lang="@languages[i].Code" aria-current="@(languages[i].Code == lang ? "true" : null)">@(languages[i].Code == "he" ? "עב" : languages[i].Code.ToUpperInvariant())</a>
                }
            </span>
        }
        <a href="@contactUrl" class="btn btn--brass btn--sm">Schedule a call</a>
    </div>
</header>

<main id="main">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="site-footer__inner">
        <div class="site-footer__top">
            <div class="site-footer__brand">
                <div class="logo">@await Html.PartialAsync("Partials/Broudo/Logo")</div>
                <p class="site-footer__tagline">@(settings?.Value<string>("footerTagline") ?? "Real estate development in Atlanta and Florida.")</p>
            </div>
            <div class="site-footer__cols">
                <div class="site-footer__col">
                    <span class="site-footer__heading">EXPLORE</span>
                    @foreach (var (label, url) in footerNavigation)
                    {
                        <a href="@url">@label</a>
                    }
                </div>
                <div class="site-footer__col">
                    <span class="site-footer__heading">CONTACT</span>
                    @if (email != "") { <a href="mailto:@email">@email</a> }
                    @if (phone != "") { <a href="tel:@(new string(phone.Where(c => char.IsDigit(c) || c == '+').ToArray()))">@phone</a> }
                    <a href="@whatsApp">WhatsApp</a>
                    <a href="@contactUrl">Schedule a call</a>
                </div>
                @if (linkedIn is not null || instagram is not null)
                {
                    <div class="site-footer__col">
                        <span class="site-footer__heading">FOLLOW</span>
                        @if (linkedIn is not null) { <a href="@linkedIn.Url" target="_blank" rel="noopener">LinkedIn</a> }
                        @if (instagram is not null) { <a href="@instagram.Url" target="_blank" rel="noopener">Instagram</a> }
                    </div>
                }
            </div>
        </div>
        <div class="site-footer__bottom">
            <div class="site-footer__legal">
                <span>© @DateTime.Now.Year @company@(registeredIn is { Length: > 0 } ? " · Registered in " + registeredIn : "")</span>
                @foreach (var legalPage in legalPages)
                {
                    <a href="@legalPage.Url()">@legalPage.NavigationLabel()</a>
                }
            </div>
            @if (settings?.Value<string>("legalDisclaimer") is { Length: > 0 } disclaimer)
            {
                <p class="site-footer__disclaimer">@disclaimer</p>
            }
        </div>
    </div>
</footer>

<a class="whatsapp-fab" href="@whatsApp" aria-label="Chat on WhatsApp">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0E1B2C" stroke-width="1.8" aria-hidden="true"><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1.2-1.6-2-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-2z"/></svg>
</a>

<script src="~/js/main.js" asp-append-version="true"></script>
</body>
</html>
